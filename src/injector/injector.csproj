<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>audit-tool</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\build\libs\barry-0.1.0.jar">
      <LogicalName>agent.jar</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\jattach\jattach.exe">
      <LogicalName>jattach.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
