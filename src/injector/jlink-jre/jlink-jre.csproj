<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>jlink_jre</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net7.0\win-x64\jlink-jre\bin</PublishDir>
  </PropertyGroup>

  <Target Name="CreateJlinkImage" AfterTargets="Build">
    <!-- Create output directory -->
    <MakeDir Directories="$(PublishDir)" />

    <!-- Run jlink via dotnet to avoid MSBuild quoting issues -->
    <Exec Command='dotnet exec "$(ProjectDir)bin\Release\net7.0\win-x64\jlink-jre.dll"'
          WorkingDirectory="$(ProjectDir)"
          ConsoleToMSBuild="true" />

    <Message Importance="High" Text="JRE created at: $(PublishDir)" />
  </Target>

</Project>
